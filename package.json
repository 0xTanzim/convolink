{
  "name": "convolink",
  "version": "1.3.7",
  "description": "Autonomous AI conversation runtime linking web models (ChatGPT, DeepSeek, Gemini) to local development workflows with automated artifact extraction, stream continuation, and non-blocking security gating",
  "license": "MIT",
  "author": "Tanzim Hossain <tanzimhossain2@gmail.com> (https://github.com/0xTanzim)",
  "homepage": "https://0xtanzim.github.io/convolink/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xTanzim/convolink.git"
  },
  "bugs": {
    "url": "https://github.com/0xTanzim/convolink/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "cursor",
    "claude-code",
    "antigravity",
    "windsurf",
    "chatgpt",
    "claude",
    "deepseek",
    "gemini",
    "browser-automation",
    "cdp",
    "ai-agents"
  ],
  "type": "module",
  "main": "./dist/cli.js",
  "mcpName": "convolink",
  "bin": {
    "convolink": "dist/cli.js",
    "convo": "dist/cli.js",
    "convolink-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "workspaces": [
    "extensions/*",
    "website"
  ],
  "scripts": {
    "test": "bun test --parallel=1",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "convolink": "bun run bin/convolink.ts",
    "convo": "bun run bin/convo.ts",
    "bridge": "bun run bin/convolink.ts",
    "build": "bun run scripts/build-dist.ts",
    "build:dist": "bun run scripts/build-dist.ts",
    "build:extension": "bun run scripts/build-extension.ts",
    "build:docs": "bun run --cwd website build",
    "prepublishOnly": "bun run build:dist",
    "release": "bun run scripts/release.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.13.0",
    "typescript": "^7.0.2"
  }
}
