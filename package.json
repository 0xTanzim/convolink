{
  "name": "convolink",
  "version": "1.0.0",
  "description": "Autonomous AI conversation runtime linking web models (ChatGPT, DeepSeek, Gemini) to local development workflows with automated artifact extraction, stream continuation, and non-blocking security gating",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "convolink": "./bin/convolink.ts",
    "convo": "./bin/convo.ts"
  },
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "test": "bun test --parallel=1",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "convolink": "bun run bin/convolink.ts",
    "convo": "bun run bin/convo.ts",
    "bridge": "bun run bin/convolink.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.13.0",
    "typescript": "^7.0.2"
  }
}
